# Copy to .env and fill in values
SECRET_KEY=your-very-secret-key-here-change-in-production
DATABASE_URL=postgresql://postgres:NewPassword123@localhost:5432/smartverify
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost"]
DEBUG=false
UPLOAD_DIR=/app/uploads
REPORT_DIR=/app/reports
MIN_INCOME_FOR_LOAN=25000
MIN_VERIFICATION_SCORE=60
FRAUD_RISK_THRESHOLD=70

# ── Admin Bootstrap & Demo Seeding ─────────────────────────────────────────
SEED_DEMO_USERS=false
# Optional one-time initial administrator bootstrap (leave empty after first boot)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Storage Configuration (local or supabase) ──────────────────────────
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_DOCUMENTS_BUCKET=applicant-documents
SUPABASE_REPORTS_BUCKET=generated-reports

# ── Multi-Agent (CrewAI) Settings ───────────────────────────────────────
CREWAI_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini/gemini-flash-latest
CREWAI_TEMPERATURE=0.2

# Preserved Alternative Provider Configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
